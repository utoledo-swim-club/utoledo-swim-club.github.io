---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = 'UToledo Swim Club: a student-run swim club at the University of Toledo. Practice Monday, Tuesday and Thursday, 7 to 8 PM at the Student Recreation Center pool. All levels welcome.',
  current = '',
} = Astro.props;

const fullTitle = title ? `${title} | UToledo Swim Club` : 'UToledo Swim Club';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo-mark.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
