---
import { club } from '../data/club';

interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const links = [
  { href: '/#schedule', label: 'Schedule', key: 'schedule' },
  { href: '/journal', label: 'Journal', key: 'journal' },
  { href: '/roster', label: 'Roster', key: 'roster' },
  { href: '/meets', label: 'Meets', key: 'meets' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img src="/logo-mark.png" alt="" width="48" height="48" class="brand__logo" />
      <span class="brand__name">{club.name}</span>
    </a>

    <nav aria-label="Main" class="nav">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['nav__link', link.key === current && 'is-active']}
          aria-current={link.key === current ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href="/join" class="btn btn--gold nav__cta" aria-current={current === 'join' ? 'page' : undefined}>
        Join the club
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy);
    color: #fff;
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    text-decoration: none;
  }
  .brand:hover { color: #fff; }
  .brand__logo { width: 48px; height: 48px; }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    font-size: 15px;
    font-weight: 500;
  }
  .nav__link {
    color: #fff;
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 2px solid transparent;
  }
  .nav__link:hover { color: var(--gold); }
  .nav__link.is-active { border-bottom-color: var(--gold); }
  .nav__cta { min-height: 44px; padding: 0 20px; font-size: 15px; }

  @media (max-width: 760px) {
    .nav { width: 100%; justify-content: space-between; gap: 4px 16px; }
    .nav__cta { width: 100%; margin-top: 6px; }
  }
</style>
