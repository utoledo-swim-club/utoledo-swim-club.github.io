---
import { club } from '../data/club';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <div class="site-footer__name">{club.name}</div>
      <p>A registered student organization at the University of Toledo.</p>
    </div>
    <nav aria-label="Footer" class="site-footer__links">
      <a href={club.instagramUrl} target="_blank" rel="noopener">Instagram</a>
      <a href={`mailto:${club.email}`}>{club.email}</a>
      <a href={club.invonetUrl} target="_blank" rel="noopener">InvoNet</a>
      <a href="/guestbook">Guestbook</a>
    </nav>
  </div>
  <div class="container site-footer__base">© {year} {club.name}</div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: var(--on-navy-muted);
    font-size: 15px;
    padding: 48px 0 32px;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    text-transform: uppercase;
    color: #fff;
  }
  .site-footer__about p { margin: 4px 0 0; }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
  }
  .site-footer__links a {
    color: #fff;
    text-decoration: none;
    padding: 10px 0;
  }
  .site-footer__links a:hover { color: var(--gold); }
  .site-footer__base {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid #1E3354;
    font-size: 14px;
  }
</style>
