---
interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const links = [
  { href: '/',          label: 'HOME',      key: 'home' },
  { href: '/journal',   label: 'JOURNAL',   key: 'journal' },
  { href: '/roster',    label: 'ROSTER',    key: 'roster' },
  { href: '/meets',     label: 'MEETS',     key: 'meets' },
  { href: '/join',      label: 'JOIN',      key: 'join' },
  { href: '/guestbook', label: 'GUESTBOOK', key: 'guestbook' },
];
---

<nav class="nav" aria-label="Main">
  <ul class="nav__list">
    {links.map(link => {
      const active = link.key === current;
      const variant = link.key === 'join' ? 'btn--gold' : (link.key === 'journal' ? 'btn--pink' : '');
      return (
        <li>
          <a
            href={link.href}
            class:list={['btn', variant, active && 'is-active']}
            aria-current={active ? 'page' : undefined}
          >
            [ {link.label} ]
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .nav { margin-bottom: 10px; }
  .nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .is-active {
    background: var(--gold) !important;
    color: var(--navy-deep) !important;
    border-color: var(--gold-light) !important;
  }
</style>
