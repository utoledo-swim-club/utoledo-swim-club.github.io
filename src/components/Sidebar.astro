---
interface Props {
  lastUpdated?: string;
  nextPractice?: string;
}

const {
  lastUpdated = 'april 23, 2026',
  nextPractice = 'thurs 7pm',
} = Astro.props;
---

<aside class="sidebar stack">

  <div class="block block--navy hit-counter" aria-label="Visitors counter">
    <div class="hit-counter__label">swimmers visited</div>
    <div class="hit-counter__value mono" id="hitCounter">00127</div>
  </div>

  <div class="block block--gold under-construction">
    <svg width="18" height="24" viewBox="0 0 14 20" aria-hidden="true">
      <rect x="0" y="14" width="14" height="5" fill="var(--pink)" stroke="#0b2a5c" stroke-width=".5"/>
      <circle cx="7" cy="4" r="3" fill="var(--cream)" stroke="#0b2a5c" stroke-width=".5"/>
      <rect x="5" y="7" width="4" height="8" fill="var(--cream)"/>
      <g style="animation: wobble .8s ease-in-out infinite; transform-origin: 6px 18px;">
        <rect x="5" y="6" width="2" height="10" fill="#8b4513"/>
        <rect x="2" y="4" width="7" height="4" fill="var(--navy)"/>
      </g>
    </svg>
    <span>under construction<br/>always swimming</span>
  </div>

  <div class="block block--pink text-center">
    <div style="font-size:11px">last updated</div>
    <div style="font-weight:500">{lastUpdated}</div>
  </div>

  <div class="block block--dashed text-center">
    <div style="font-size:11px">next practice</div>
    <div style="font-weight:500">{nextPractice} <span style="color:var(--pink)">&#9825;</span></div>
  </div>

</aside>

<style>
  .hit-counter {
    text-align: center;
    padding: 9px;
  }
  .hit-counter__label {
    font-size: 11px;
    margin-bottom: 3px;
    color: var(--gold);
  }
  .hit-counter__value {
    font-size: 20px;
    letter-spacing: 4px;
    font-weight: 500;
    color: var(--cream);
  }
  .under-construction {
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    line-height: 1.4;
    text-align: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .under-construction svg g { animation: none !important; }
  }
</style>

<script>
  // Fake-but-persistent hit counter using localStorage.
  // Each visitor sees their own count increase. Not a real shared counter.
  // To make it real, swap in a service like counter.dev, goatcounter, or counter.tool.
  try {
    const el = document.getElementById('hitCounter');
    if (el) {
      const key = 'utoledo-swim-hits';
      const base = 127;
      let n = parseInt(localStorage.getItem(key) || '0', 10);
      n = Number.isFinite(n) ? n + 1 : 1;
      localStorage.setItem(key, String(n));
      const display = (base + n).toString().padStart(5, '0');
      el.textContent = display;
    }
  } catch (_) { /* storage disabled, leave the default number */ }
</script>
