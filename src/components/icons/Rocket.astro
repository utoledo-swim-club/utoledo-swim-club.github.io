---
// Reusable rocket icon. Strictly blue + yellow + white flame — no red, no pink.
// Usage: <Rocket size={28} variant="gold" animated />
interface Props {
  size?: number;
  variant?: 'gold' | 'navy';
  animated?: boolean;
  class?: string;
}

const {
  size = 28,
  variant = 'gold',
  animated = false,
  class: className = '',
} = Astro.props;

const body = variant === 'gold' ? '#FFD100' : '#0b2a5c';
const porthole = variant === 'gold' ? '#15397F' : '#FFD100';
const height = Math.round(size * 1.5);
---

<svg
  viewBox="0 0 24 36"
  width={size}
  height={height}
  class={className}
  aria-hidden="true"
>
  <path
    d="M12 2 Q18 12 18 22 L18 28 L6 28 L6 22 Q6 12 12 2 Z"
    fill={body}
    stroke="#0b2a5c"
    stroke-width="1.5"
  />
  <circle cx="12" cy="14" r="3" fill={porthole} />
  <path
    d="M6 28 L3 34 L8 30 Z M18 28 L21 34 L16 30 Z"
    fill={body}
    stroke="#0b2a5c"
    stroke-width="1"
  />
  <path
    class={animated ? 'rk-flame' : ''}
    d="M9 30 L12 36 L15 30 Z"
    fill="#fff"
  />
</svg>
