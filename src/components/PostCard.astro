---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const href = `/journal/${post.id.replace(/\.md$/, '')}`;
const date = post.data.date.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---

<a href={href} class="post-card">
  {post.data.cover ? (
    <img src={post.data.cover} alt="" class="post-card__media" loading="lazy" />
  ) : (
    <div class="post-card__media post-card__media--blank" aria-hidden="true">
      <img src="/logo-mark.png" alt="" width="96" height="96" />
    </div>
  )}
  <div class="post-card__body">
    {post.data.week && <span class="tag">Week {post.data.week}</span>}
    <h3 class="post-card__title">{post.data.title}</h3>
    {post.data.excerpt && <p class="post-card__excerpt">{post.data.excerpt}</p>}
    <div class="post-card__date">{date}</div>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .post-card:hover {
    color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(11, 31, 58, 0.08);
  }
  .post-card__media { width: 100%; height: 200px; object-fit: cover; }
  .post-card__media--blank {
    background: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .post-card__media--blank img { width: 96px; height: 96px; opacity: 0.9; }
  .post-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    flex: 1;
  }
  .post-card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
    margin: 0;
  }
  .post-card__excerpt { margin: 0; font-size: 15px; color: var(--muted); }
  .post-card__date { margin-top: auto; font-size: 14px; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    .post-card { transition: none; }
    .post-card:hover { transform: none; }
  }
</style>
