---
import BaseLayout from '../layouts/BaseLayout.astro';
import { club, practiceSummary } from '../data/club';

const steps = [
  { title: 'Show up to practice', body: `${practiceSummary}, at the ${club.location}.` },
  { title: 'Bring your gear', body: 'Suit, goggles, cap and a towel. We have extra caps if you forget.' },
  { title: 'First practice is free', body: 'No commitment. Just come try it and meet the team.' },
  { title: 'Register and pay dues', body: `Sign up on InvoNet and pay club dues (${club.dues}). Dues cover pool time and travel.` },
];

const faqs = [
  { q: "I haven't swum since high school, or ever. Is that okay?", a: 'Yes. We have swimmers at every level. Come as you are.' },
  { q: 'Do I have to compete?', a: 'No. Meets are optional. Some people only come for practice and team dinners, and that is fine.' },
  { q: 'Can I join mid-semester?', a: 'Yes. Come whenever you want.' },
  { q: 'What happens at a first practice?', a: 'Warm up, some drills, a main set and a cool down, about 2,000 to 3,000 yards total. You can sit out sets if you need to.' },
];
---

<BaseLayout title="Join" current="join">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Join the club</p>
      <h1 class="display">No tryouts.<br />No cut times.</h1>
      <p class="lede">If you can get yourself down a lane, you can join.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2 class="display h2">Four steps</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step card">
            <div class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <div class="step__title">{s.title}</div>
            <p class="step__body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container faq-wrap">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 class="display h2">FAQ</h2>
      </div>
      <div class="faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container contact">
      <div>
        <h2 class="display contact__title">Get in touch</h2>
        <p class="lede">Questions before your first practice? Reach out any way you like.</p>
      </div>
      <div class="btn-row">
        <a href={`mailto:${club.email}`} class="btn btn--gold">Email us</a>
        <a href={club.instagramUrl} target="_blank" rel="noopener" class="btn btn--ghost">DM on Instagram</a>
        <a href={club.invonetUrl} target="_blank" rel="noopener" class="btn btn--ghost">Find us on InvoNet</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .step__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    color: var(--navy);
    line-height: 1;
  }
  .step__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.15;
    margin-top: 12px;
  }
  .step__body { margin: 8px 0 0; color: var(--muted); font-size: 16px; }

  .faq-wrap { display: flex; flex-wrap: wrap; gap: 48px; }
  .faq-wrap > div:first-child { flex: 1 1 260px; }
  .faqs { flex: 2 1 560px; min-width: 0; }
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 18px;
    padding: 20px 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-size: 24px; line-height: 1; color: var(--muted); }
  .faq[open] summary::after { content: '−'; }
  .faq p { margin: 0 0 20px; color: var(--muted); }

  .contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 40px; }
  .contact > div:first-child { flex: 1 1 420px; }
  .contact__title { font-size: clamp(44px, 7vw, 64px); }
</style>
