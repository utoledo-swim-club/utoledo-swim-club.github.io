---
import BaseLayout from '../layouts/BaseLayout.astro';
import { upcomingMeets, pastMeets, type Meet } from '../data/meets';

// Meets are listed in src/data/meets.ts
const groups: { title: string; meets: Meet[] }[] = [
  { title: 'Upcoming', meets: upcomingMeets },
  { title: 'Results', meets: pastMeets },
];
---

<BaseLayout title="Meets" current="meets">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Competition</p>
      <h1 class="display">Meets</h1>
      <p class="lede">Upcoming and recent meets. Results go up a day or two after each one. Meets are always optional.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {groups.map((g) => (
        <div class="meet-group">
          <h2 class="display meet-group__title">{g.title}</h2>
          {g.meets.length > 0 ? (
            <ul class="meet-list">
              {g.meets.map((m) => (
                <li class="meet">
                  <div class="meet__date">{m.date}</div>
                  <div class="meet__info">
                    <div class="meet__name">{m.name}</div>
                    <div class="meet__loc">{m.location}</div>
                    {m.notes && <p class="meet__notes">{m.notes}</p>}
                  </div>
                  {m.status === 'upcoming' && <span class="tag tag--gold">Upcoming</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="meet-empty">{g.title === 'Upcoming' ? 'No meets scheduled yet. Check back soon.' : 'No results posted yet.'}</p>
          )}
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .meet-group + .meet-group { margin-top: 64px; }
  .meet-group__title { font-size: 36px; margin-bottom: 8px; }
  .meet-list { list-style: none; padding: 0; margin: 0; }
  .meet {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 12px 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .meet__date {
    flex: 0 0 160px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    text-transform: uppercase;
  }
  .meet__info { flex: 1 1 300px; min-width: 0; }
  .meet__name { font-family: var(--font-display); font-weight: 700; font-size: 28px; line-height: 1.15; }
  .meet__loc { color: var(--muted); font-size: 15px; }
  .meet__notes { margin: 8px 0 0; }
  .meet-empty { color: var(--muted); }
</style>
