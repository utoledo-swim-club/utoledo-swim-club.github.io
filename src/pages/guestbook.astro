---
import BaseLayout from '../layouts/BaseLayout.astro';
import { club } from '../data/club';

// Add new entries to the TOP of this list when people email them in.
const entries = [
  {
    name: 'Joshua',
    date: '2026-04-24',
    message: 'First! Welcome to the guestbook. Sign it so future teams can see who stopped by.',
  },
];

const mailto = `mailto:${club.email}?subject=Guestbook%20entry`;
---

<BaseLayout title="Guestbook" current="guestbook">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Say hi</p>
      <h1 class="display">Guestbook</h1>
      <p class="lede">Leave a note for the team. Alumni especially welcome.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container gb">
      <div class="card gb__sign">
        <h2 class="display gb__title">Sign the guestbook</h2>
        <p>Email your name, where you're from and a short message to <a href={mailto}>{club.email}</a> with the subject "Guestbook entry".</p>
        <a href={mailto} class="btn btn--navy">Sign the guestbook</a>
      </div>
      <ul class="gb__list">
        {entries.map((e) => (
          <li class="card">
            <div class="gb__meta"><strong>{e.name}</strong><span>{e.date}</span></div>
            <p class="gb__msg">{e.message}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  .gb { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .gb__sign { flex: 1 1 320px; }
  .gb__title { font-size: 32px; margin-bottom: 8px; }
  .gb__list { flex: 2 1 480px; min-width: 0; list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .gb__meta { display: flex; justify-content: space-between; gap: 12px; font-size: 15px; color: var(--muted); }
  .gb__meta strong { color: var(--ink); }
  .gb__msg { margin: 8px 0 0; }
</style>
