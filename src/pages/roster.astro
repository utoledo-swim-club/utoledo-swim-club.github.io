---
import BaseLayout from '../layouts/BaseLayout.astro';

// Edit this list as membership changes.
// To add a photo: put the file in public/roster/ and set photo: '/roster/filename.jpg'
const roster: { name: string; role?: string; year?: string; photo?: string }[] = [
  { name: 'Joshua Pereira', role: 'Social Media and Website' },
  { name: 'John Best' },
  { name: 'Aaron Samuel' },
  { name: 'Bryant Geer' },
  { name: 'Nonso Nwogu' },
];

const advisor = { name: 'Professor Weiqing Sun', role: 'Faculty Advisor' };

const initials = (name: string) =>
  name.split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase();
---

<BaseLayout title="Roster" current="roster">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">The team</p>
      <h1 class="display">Roster</h1>
      <p class="lede">The swimmers who make this club happen. Want to be on this list? <a href="/join">Come join.</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <ul class="people">
        {roster.map((p) => (
          <li class="person card">
            {p.photo
              ? <img src={p.photo} alt="" class="person__avatar" />
              : <div class="person__avatar person__avatar--initials" aria-hidden="true">{initials(p.name)}</div>}
            <div class="person__name">{p.name}</div>
            {p.role && <div class="person__role">{p.role}</div>}
            {p.year && <div class="person__role">Class of {p.year}</div>}
          </li>
        ))}
      </ul>

      <h2 class="display advisor-title">Faculty advisor</h2>
      <ul class="people">
        <li class="person card">
          <div class="person__avatar person__avatar--initials" aria-hidden="true">{initials(advisor.name.replace('Professor ', ''))}</div>
          <div class="person__name">{advisor.name}</div>
          <div class="person__role">{advisor.role}</div>
        </li>
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  .people {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
  .person { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .person__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 12px;
  }
  .person__avatar--initials {
    background: var(--navy);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
  }
  .person__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
  }
  .person__role { font-size: 15px; color: var(--muted); }
  .advisor-title { font-size: 36px; margin: 64px 0 24px; }
</style>
