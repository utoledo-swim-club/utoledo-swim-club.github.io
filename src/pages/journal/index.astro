---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Journal" current="journal">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Club journal</p>
      <h1 class="display">Journal</h1>
      <p class="lede">Practice recaps, meet results, team dinners and everything else that happens at swim club.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      {posts.length > 0 ? (
        <div class="grid-cards">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p>No posts yet. Check back soon.</p>
      )}
    </div>
  </section>

</BaseLayout>
