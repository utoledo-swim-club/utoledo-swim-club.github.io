---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const date = entry.data.date.toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt} current="journal">

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">
        {entry.data.week ? `Week ${entry.data.week} · ` : ''}{date}
      </p>
      <h1 class="display post-title">{entry.data.title}</h1>
      <p class="lede">By {entry.data.author}</p>
    </div>
  </section>

  {entry.data.cover && (
    <div class="container post-cover">
      <img src={entry.data.cover} alt="" />
    </div>
  )}

  <section class="section">
    <div class="container">
      <article class="prose">
        <Content />
        <hr />
        <p><a href="/journal">Back to the journal</a></p>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  .post-title { font-size: clamp(40px, 6vw, 64px) !important; max-width: 900px; }
  .post-cover { margin-top: -32px; }
  .post-cover img { border-radius: var(--radius); width: 100%; max-height: 520px; object-fit: cover; }
</style>
